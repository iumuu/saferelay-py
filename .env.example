# SafeRelay-Py 环境变量配置
# 复制为 .env 并填入实际值

# Telegram Bot Token（必需）
BOT_TOKEN=123456:ABC-DEF1234...

# 管理员用户 ID，逗号分隔（必需）
ADMIN_IDS=123456789,987654321

# 论坛群组 ID（可选，话题模式需要）
# GROUP_ID=-1001234567890

# 可选配置
# WELCOME_MSG=欢迎你！请先完成验证
# AUTOREPLY_MSG=客服已收到您的消息，请耐心等待回复

# 你的域名（A 记录指向 VPS）
DOMAIN=bot.example.com
# Caddy 证书通知邮箱（可选但推荐）
CADDY_EMAIL=admin@example.com

# 验证方式：quiz（默认本地题库）或 hcaptcha
# VERIFY_PROVIDER=quiz
# HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
# HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
# HCAPTCHA_WEBAPP_URL=https://bot.example.com/hcaptcha
# HCAPTCHA_WEBAPP_PORT=8080
# HCAPTCHA_VERIFY_URL=https://api.hcaptcha.com/siteverify

# 发给普通用户的消息启用 Telegram protect_content，禁止普通复制/转发
# PROTECT_USER_CONTENT=true
